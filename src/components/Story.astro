---
// The opening: one big eye blinks twice and turns into a ladybug's eyes. Scrolling then splits the ladybug into four animals, and they settle around the headline.
import { Image } from 'astro:assets';
import kepik from '../assets/critters/kepik.png';
import kupu from '../assets/critters/kupu.png';
import lebah from '../assets/critters/lebah.png';
import siput from '../assets/critters/siput.png';
import Wordmark from './Wordmark.astro';
import { eyeSvg, eyeDefs } from '../lib/eyes';
import { ANIMAL_EYES, eyeStyle } from '../lib/animalEyes';
import type { Copy } from '../i18n/id';

interface Props {
  copy: Copy;
}
const { copy } = Astro.props;
const h = copy.hero;
// Every animal wears a pair of cute eyes on top of its painted ones, and the eyes follow the pointer.
const pals = [kepik, kupu, lebah, siput];
---

<section class="story" id="top" data-story>
  <div class="stage">
    <Fragment set:html={eyeDefs} />

    <div class="pals" aria-hidden="true">
      {
        pals.map((src, i) => (
          <div class={`pal pal${i}`} data-pal={i}>
            <Image src={src} alt="" width={640} height={640} widths={[480, 800, 1100]} sizes="(max-width: 700px) 60vw, 640px" loading="eager" />
            <div class="peye" data-peye style={eyeStyle(ANIMAL_EYES[i].l)}><div class="lid" set:html={eyeSvg} /></div>
            <div class="peye" data-peye style={eyeStyle(ANIMAL_EYES[i].r)}><div class="lid" set:html={eyeSvg} /></div>
          </div>
        ))
      }
    </div>

    <div class="eyes" aria-hidden="true">
      <div class="eye" data-oeye><div class="lid" set:html={eyeSvg} /></div>
      <div class="eye" data-oeye><div class="lid" set:html={eyeSvg} /></div>
    </div>

    <div class="hero-copy" data-copy>
      <p class="kicker">{h.kicker}</p>
      <Wordmark class="mark" />
      <h1>
        <span>{h.titleA}</span> <span class="hl">{h.titleB}</span>
      </h1>
      <p class="lead">{h.sub}</p>
      <div class="cta">
        <a class="btn" href="#mencoba">{h.primary}</a>
        <a class="btn btn--ghost" href="#tentang">{h.secondary}</a>
      </div>
      <p class="note">{h.note}</p>
    </div>

    <div class="hint" data-hint aria-hidden="true">
      <span>{copy.story.scroll}</span>
      <i></i>
    </div>
  </div>
</section>

<style>
  /* Without scripting, or with reduced motion, this is a plain hero: the four animals sit at the corners of the headline. */
  .story {
    position: relative;
    min-height: 100svh;
    display: grid;
    padding: 96px 0 72px;
    overflow: clip;
  }
  .stage {
    position: relative;
    display: grid;
    place-items: center;
  }
  .eyes {
    display: none;
  }
  .pal {
    position: absolute;
    width: clamp(84px, 16vw, 210px);
    aspect-ratio: 1;
  }
  .pal0 { left: 4%; top: 4%; }
  .pal1 { right: 4%; top: 4%; }
  .pal2 { left: 4%; bottom: 4%; }
  .pal3 { right: 4%; bottom: 4%; }
  .pal :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .hero-copy {
    position: relative;
    z-index: 2;
    width: min(100% - var(--gutter) * 2, 760px);
    text-align: center;
    display: grid;
    justify-items: center;
    align-content: center;
    padding-block: 40px;
  }
  .hero-copy :global(.mark) {
    width: min(100%, 400px, 34vh);
    margin: 0.2rem 0 1rem;
    filter: drop-shadow(0 8px 0 rgba(42, 33, 69, 0.14));
  }
  h1 {
    font-size: clamp(2.2rem, 1.2rem + 3.2vw, 4rem);
    margin-bottom: 0.8rem;
  }
  .hl {
    color: #fff;
    padding: 0.02em 0.32em 0.1em;
    background: radial-gradient(80% 50% at 24% 4%, rgba(255, 255, 255, 0.55), rgba(255, 255, 255, 0) 60%), linear-gradient(180deg, #5aa4ff, #1f5fd6);
    border-radius: 0.45em;
    box-shadow: inset 0 -6px 10px rgba(0, 0, 60, 0.28), 0 14px 18px -10px rgba(31, 95, 214, 0.7);
    text-shadow: 0 2px 0 rgba(0, 0, 60, 0.22);
    transform: rotate(-1.5deg);
    display: inline-block;
  }
  .lead {
    margin-inline: auto;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
    margin: 1.6rem 0 0.9rem;
  }
  .note {
    font-weight: 600;
    color: var(--ink-soft);
    font-size: 0.95rem;
  }
  .hint {
    display: none;
  }

  /* With scripting: the section is tall and its stage stays pinned while the page scrolls through it. */
  :global(html.story-js) .story {
    height: 520vh;
    display: block;
    padding: 0;
    overflow: visible;
  }
  :global(html.story-js) .stage {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    display: block;
    background: var(--stage-bg, var(--blue));
  }
  :global(html.story-js) .pal {
    left: 0;
    top: 0;
    width: var(--pal, 400px);
    height: var(--pal, 400px);
    aspect-ratio: auto;
    transform-origin: 50% 50%;
    will-change: transform;
  }
  :global(html.story-js) .pal1 { z-index: 1; opacity: 0; }
  :global(html.story-js) .pal2 { z-index: 2; opacity: 0; }
  :global(html.story-js) .pal3 { z-index: 3; opacity: 0; }
  :global(html.story-js) .pal0 { z-index: 4; }
  :global(html.story-js) .hero-copy {
    z-index: 7;
    position: absolute;
    left: 50%;
    top: 41%;
    translate: -50% -50%;
    opacity: 0;
    padding-block: 0;
    will-change: transform, opacity;
  }
  :global(html.story-js) .pals {
    position: absolute;
    inset: 0;
  }

  /* The opening eyes are only there until the ladybug is drawn around them. */
  .eyes {
    display: none;
  }
  :global(html.opening) .eyes {
    display: block;
    position: absolute;
    inset: 0;
    z-index: 6;
    pointer-events: none;
  }
  :global(html.opening) .pal0 {
    clip-path: circle(0% at 57.2% 57.8%);
  }
  .eye {
    position: absolute;
    left: 0;
    top: 0;
    width: 200px;
    height: 260px;
    opacity: 0;
    transform-origin: 50% 50%;
    will-change: transform;
  }
  /* The eyes that live on each animal. Without scripting the painted eyes stay as they are. */
  .peye {
    display: none;
    position: absolute;
    translate: -50% -50%;
    pointer-events: none;
  }
  :global(html.story-js) .peye {
    display: block;
  }
  :global(html.opening) .pal0 .peye {
    opacity: 0;
  }
  .lid {
    width: 100%;
    height: 100%;
    transform-origin: 50% 55%;
  }
  .lid :global(.eye-svg) {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .lid :global(.pupil) {
    transition: transform 0.22s cubic-bezier(0.3, 0.7, 0.3, 1);
  }

  .hint {
    position: absolute;
    left: 50%;
    bottom: 22px;
    translate: -50% 0;
    z-index: 5;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    font-family: var(--font-display);
    font-size: 1.3rem;
    color: #fff;
    opacity: 0;
    pointer-events: none;
  }
  :global(html.story-js) .hint {
    display: flex;
  }
  .hint i {
    width: 26px;
    height: 42px;
    border: 3px solid currentColor;
    border-radius: 14px;
    position: relative;
  }
  .hint i::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 7px;
    width: 5px;
    height: 9px;
    margin-left: -2.5px;
    border-radius: 3px;
    background: currentColor;
    animation: wheel 1.5s ease-in-out infinite;
  }
  @keyframes wheel {
    0% { transform: translateY(0); opacity: 1; }
    80%, 100% { transform: translateY(14px); opacity: 0; }
  }
</style>
