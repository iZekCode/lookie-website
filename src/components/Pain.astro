---
import { Image } from 'astro:assets';
import siput from '../assets/critters/siput.png';
import kupu from '../assets/critters/kupu.png';
import kepik from '../assets/critters/kepik.png';
import type { Copy } from '../i18n/id';

interface Props {
  copy: Copy;
}
const { copy } = Astro.props;
const p = copy.pain;
const pics = [siput, kupu, kepik];
const motion = ['crawl', 'drift', 'spin'];
---

<section class="pain sheet">
  <div class="wrap">
    <div class="head">
      <p class="kicker" data-reveal>{p.kicker}</p>
      <h2 class="h2" data-reveal style="--d:1">{p.title}</h2>
      <p class="lead" data-reveal style="--d:2">{p.lead}</p>
    </div>
    <ol class="cards">
      {
        p.items.map((it, i) => (
          <li class={`card ${motion[i]}`} data-reveal style={`--d:${i + 2};--r:${[-2, 1.5, -1][i]}deg`}>
            <span class="num">{i + 1}</span>
            <h3>{it.title}</h3>
            <p>{it.text}</p>
            <Image src={pics[i]} alt="" width={150} height={150} class="pic" />
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .pain {
    background: var(--cream);
  }
  .head {
    max-width: 760px;
    margin-bottom: 3rem;
  }
  .h2 {
    margin-bottom: 1rem;
  }
  .cards {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }
  .card {
    position: relative;
    background: var(--paper);
    border: 4px solid var(--ink);
    border-radius: var(--radius);
    box-shadow: 0 8px 0 var(--ink);
    padding: 28px 24px 96px;
    rotate: var(--r);
    transition: rotate 0.3s var(--ease-bounce), translate 0.3s var(--ease-bounce);
  }
  .card:hover {
    rotate: 0deg;
    translate: 0 -6px;
  }
  .num {
    position: absolute;
    top: -22px;
    left: 22px;
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    background: var(--red);
    color: #fff;
    border: 4px solid var(--ink);
    border-radius: 50%;
    font-family: var(--font-display);
    font-size: 1.6rem;
  }
  h3 {
    font-size: 2rem;
    margin: 0.5rem 0 0.6rem;
  }
  .card p {
    color: var(--ink-soft);
  }
  .card :global(.pic) {
    position: absolute;
    right: 14px;
    bottom: 6px;
    width: 92px;
    height: auto;
  }
  .crawl :global(.pic) { animation: crawl 5s ease-in-out infinite; }
  .drift :global(.pic) { animation: drift 4s ease-in-out infinite; }
  .spin :global(.pic) { animation: spin-tilt 3.2s ease-in-out infinite; }
  @keyframes crawl {
    0%, 100% { transform: translateX(0); }
    50% { transform: translateX(-60px); }
  }
  @keyframes drift {
    0%, 100% { transform: translate(0, 0) rotate(-6deg); }
    50% { transform: translate(14px, -22px) rotate(8deg); }
  }
  @keyframes spin-tilt {
    0%, 100% { transform: rotate(-10deg); }
    50% { transform: rotate(14deg) translateY(-6px); }
  }
  @media (max-width: 860px) {
    .cards {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }
</style>
