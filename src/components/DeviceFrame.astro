---
// An iPad bezel around a screenshot.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  class?: string;
  width?: number;
  loading?: 'eager' | 'lazy';
}
const { src, alt, class: className = '', width = 1000, loading = 'lazy' } = Astro.props;
---

<div class:list={['ipad', className]}>
  <Image src={src} alt={alt} width={width} loading={loading} class="shot" widths={[500, 800, 1100]} sizes="(max-width: 900px) 90vw, 560px" />
</div>

<style>
  .ipad {
    background: #17151f;
    padding: 2.4%;
    border-radius: 5.2% / 7%;
    box-shadow:
      0 0 0 2px #3b3850,
      0 30px 50px -18px rgba(42, 33, 69, 0.45),
      0 10px 0 -2px rgba(42, 33, 69, 0.12);
    position: relative;
  }
  .ipad::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 0.9%;
    width: 0.7%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: #2e2b3d;
    transform: translateY(-50%);
  }
  .ipad :global(.shot) {
    width: 100%;
    height: auto;
    border-radius: 3.2% / 4.4%;
  }
</style>
