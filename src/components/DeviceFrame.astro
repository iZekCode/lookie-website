---
// An iPad bezel around a short screen recording. The video is played by src/scripts/clips.ts while it is on screen.
import { assetUrl } from '../i18n';

interface Props {
  clip: string;
  label: string;
  class?: string;
}
const { clip, label, class: className = '' } = Astro.props;
---

<div class:list={['ipad', className]}>
  <video class="shot" muted loop playsinline preload="metadata" data-clip poster={assetUrl(`clips/${clip}.jpg`)} aria-label={label}>
    <source src={assetUrl(`clips/${clip}.mp4`)} type="video/mp4" />
  </video>
</div>

<style>
  .ipad {
    background: #17151f;
    padding: 2.4%;
    border-radius: 5.2% / 7%;
    box-shadow:
      0 0 0 2px #3b3850,
      0 30px 50px -18px rgba(42, 33, 69, 0.45),
      0 10px 0 -2px rgba(42, 33, 69, 0.12);
    position: relative;
  }
  .ipad::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 0.9%;
    width: 0.7%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: #2e2b3d;
    transform: translateY(-50%);
  }
  .shot {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    background: #fff;
    border-radius: 3.2% / 4.4%;
  }
</style>
