---
import { Image } from 'astro:assets';
import icon from '../assets/icon.png';
import kepik from '../assets/critters/kepik.png';
import lebah from '../assets/critters/lebah.png';
import type { Copy } from '../i18n/id';

interface Props {
  copy: Copy;
}
const { copy } = Astro.props;
const a = copy.about;
---

<section class="about sheet" id="tentang">
  <div class="wrap grid">
    <div class="text">
      <p class="kicker" data-reveal>{a.kicker}</p>
      <h2 class="h2" data-reveal style="--d:1">{a.title}</h2>
      <p class="lead" data-reveal style="--d:2">{a.p1}</p>
      <p class="lead second" data-reveal style="--d:3">{a.p2}</p>
      <ul class="stickers" data-reveal style="--d:4">
        {a.stickers.map((s, i) => <li class="puffy" style={`--r:${[-3, 2, -1.5][i]}deg`}>{s}</li>)}
      </ul>
    </div>

    <div class="mascot" data-reveal style="--d:2" data-tilt>
      <span class="ring"></span>
      <Image src={icon} alt="" width={520} height={520} class="face" />
      <Image src={kepik} alt="" width={140} height={140} class="mini m1" />
      <Image src={lebah} alt="" width={140} height={140} class="mini m2" />
    </div>
  </div>
</section>

<style>
  .about {
    --bg: #fffbf1;
  }
  .grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(32px, 6vw, 88px);
    align-items: center;
  }
  .h2 {
    margin-bottom: 1.2rem;
  }
  .second {
    margin-top: 1rem;
  }
  .stickers {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }
  .stickers li {
    font-family: var(--font-display);
    font-size: 1.3rem;
    padding: 0.35em 1.1em 0.45em;
    border-radius: 99px;
    color: var(--ink);
    transform: rotate(var(--r));
    transition: transform 0.3s var(--ease-bounce);
  }
  .stickers li:nth-child(1) { --tint: #ffd75a; }
  .stickers li:nth-child(2) { --tint: #ffa9cb; }
  .stickers li:nth-child(3) { --tint: #bfe8a8; }
  .stickers li:hover {
    transform: rotate(0) scale(1.1);
  }
  .mascot {
    position: relative;
    aspect-ratio: 1;
    max-width: 440px;
    width: 100%;
    margin-inline: auto;
  }
  .mascot :global(.face) {
    position: relative;
    width: 82%;
    height: 82%;
    margin: 9%;
    border-radius: 36%;
    box-shadow:
      inset 0 -14px 24px -8px rgba(0, 0, 60, 0.3),
      inset 0 8px 12px -2px rgba(255, 255, 255, 0.6),
      0 40px 50px -26px rgba(31, 95, 214, 0.65);
    animation: breathe 4.5s ease-in-out infinite;
    transition: transform 0.4s var(--ease-bounce);
  }
  .mascot:hover :global(.face) {
    transform: rotate(-6deg) scale(1.04);
  }
  .ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: radial-gradient(circle at 30% 24%, rgba(255, 255, 255, 0.9), rgba(255, 255, 255, 0) 30%), radial-gradient(circle, rgba(150, 200, 255, 0.25), rgba(150, 200, 255, 0.5));
    box-shadow: inset 0 -16px 30px rgba(60, 130, 230, 0.25);
    animation: spin 40s linear infinite;
  }
  .mascot :global(.mini) {
    position: absolute;
    width: 28%;
    height: auto;
    filter: drop-shadow(0 12px 8px rgba(42, 33, 69, 0.22));
  }
  .mascot :global(.m1) {
    left: -4%;
    bottom: 6%;
    animation: bob 3.4s ease-in-out infinite;
  }
  .mascot :global(.m2) {
    right: -2%;
    top: 2%;
    animation: bob 2.6s ease-in-out -1s infinite;
  }
  @keyframes breathe {
    0%, 100% { scale: 1; }
    50% { scale: 1.035; }
  }
  @keyframes spin {
    to { transform: rotate(360deg); }
  }
  @keyframes bob {
    0%, 100% { transform: translateY(0) rotate(-4deg); }
    50% { transform: translateY(-14px) rotate(5deg); }
  }
  @media (max-width: 860px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .mascot {
      max-width: 320px;
      order: -1;
    }
  }
</style>
