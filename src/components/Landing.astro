---
import Base from '../layouts/Base.astro';
import Hero from './Hero.astro';
import About from './About.astro';
import Cp from './Cp.astro';
import Pain from './Pain.astro';
import How from './How.astro';
import Audience from './Audience.astro';
import Report from './Report.astro';
import Testing from './Testing.astro';
import Cta from './Cta.astro';
import { useCopy, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const copy = useCopy(lang);
---

<Base lang={lang} title={copy.meta.title} description={copy.meta.description} twinPath="">
  <main id="main">
    <Hero copy={copy} />
    <About copy={copy} />
    <Cp copy={copy} />
    <Pain copy={copy} />
    <How copy={copy} />
    <Audience copy={copy} />
    <Report copy={copy} />
    <Testing copy={copy} />
    <Cta copy={copy} />
  </main>
</Base>
