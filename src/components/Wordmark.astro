---
// The Lookie logo, built from the app's own letter files and shown as a still picture.
import L from '../assets/logo/lookieL.svg?raw';
import K from '../assets/logo/lookieK.svg?raw';
import I from '../assets/logo/lookieI.svg?raw';
import E from '../assets/logo/lookieE.svg?raw';
import EyeLeft from '../assets/logo/lookieEyeLeft.svg?raw';
import EyeRight from '../assets/logo/lookieEyeRight.svg?raw';

interface Props {
  class?: string;
  label?: string;
}
const { class: className = '', label = 'Lookie' } = Astro.props;

const place = (svg: string, x: number, y: number) => svg.replace('<svg ', `<svg x="${x}" y="${y}" `);

const parts = [
  { cls: 'l', svg: place(L, 0, 26) },
  { cls: 'eye', svg: place(EyeLeft, 409, 93) },
  { cls: 'eye', svg: place(EyeRight, 757, 57) },
  { cls: 'k', svg: place(K, 1126, 35) },
  { cls: 'i', svg: place(I, 1600, 0) },
  { cls: 'e', svg: place(E, 1864, 93) },
];
---

<svg
  class:list={['wordmark', className]}
  viewBox="0 0 2284 604"
  role="img"
  aria-label={label}
>
  {
    parts.map((p) => (
      <g class={`wm-${p.cls}`} set:html={p.svg} />
    ))
  }
</svg>

<style is:global>
  .wordmark {
    width: 100%;
    height: auto;
    overflow: visible;
  }
</style>
