---
import { Image } from 'astro:assets';
import kupu from '../assets/critters/kupu.png';
import lebah from '../assets/critters/lebah.png';
import type { Copy } from '../i18n/id';

interface Props {
  copy: Copy;
}
const { copy } = Astro.props;
const a = copy.audience;
const cols = [
  { data: a.kids, cls: 'kids', pic: kupu },
  { data: a.parents, cls: 'parents', pic: lebah },
];
---

<section class="aud sheet" id="orang-tua">
  <div class="wrap two">
    {
      cols.map((c, i) => (
        <article class={`col puffy ${c.cls}`} data-reveal style={`--d:${i}`}>
          <Image src={c.pic} alt="" width={200} height={200} class="pic" />
          <h2>{c.data.title}</h2>
          <ul>
            {c.data.items.map((t) => <li>{t}</li>)}
          </ul>
        </article>
      ))
    }
  </div>
</section>

<style>
  .aud {
    --bg: #ffe7a3;
  }
  .two {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 36px;
  }
  .col {
    position: relative;
    padding: clamp(32px, 4vw, 52px);
    border-radius: 48px;
    color: #fff;
    transition: rotate 0.4s var(--ease-bounce);
  }
  .col.kids {
    --tint: #3f8ef2;
    rotate: -1deg;
  }
  .col.parents {
    --tint: #e0452b;
    rotate: 1deg;
  }
  .col:hover {
    rotate: 0deg;
  }
  h2 {
    font-size: clamp(2.2rem, 1.6rem + 2.4vw, 3.4rem);
    margin-bottom: 1.2rem;
    text-shadow: 0 3px 0 rgba(0, 0, 60, 0.18);
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 14px;
  }
  li {
    position: relative;
    padding-left: 2.1em;
    font-weight: 600;
    font-size: 1.1rem;
  }
  li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.3em;
    width: 1.2em;
    height: 1.2em;
    background: radial-gradient(circle at 32% 26%, #fff 0 14%, rgba(255, 255, 255, 0) 34%), linear-gradient(180deg, #ffe375, #f5a812);
    border-radius: 50%;
    box-shadow: inset 0 -3px 4px rgba(150, 80, 0, 0.35), 0 4px 6px -2px rgba(0, 0, 40, 0.35);
  }
  .col :global(.pic) {
    position: absolute;
    top: -38px;
    right: 26px;
    width: 96px;
    height: auto;
    animation: bob 3.4s ease-in-out infinite;
    filter: drop-shadow(0 8px 6px rgba(42, 33, 69, 0.3));
  }
  @keyframes bob {
    0%, 100% { transform: translateY(0) rotate(-5deg); }
    50% { transform: translateY(-10px) rotate(6deg); }
  }
  @media (max-width: 860px) {
    .two {
      grid-template-columns: 1fr;
      gap: 48px;
    }
  }
</style>
