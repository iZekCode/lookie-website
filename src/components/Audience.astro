---
import { Image } from 'astro:assets';
import kupu from '../assets/critters/kupu.png';
import lebah from '../assets/critters/lebah.png';
import type { Copy } from '../i18n/id';

interface Props {
  copy: Copy;
}
const { copy } = Astro.props;
const a = copy.audience;
const cols = [
  { data: a.kids, cls: 'kids', pic: kupu },
  { data: a.parents, cls: 'parents', pic: lebah },
];
---

<section class="aud sheet" id="orang-tua">
  <div class="wrap two">
    {
      cols.map((c, i) => (
        <article class={`col ${c.cls}`} data-reveal style={`--d:${i}`}>
          <Image src={c.pic} alt="" width={200} height={200} class="pic" />
          <h2>{c.data.title}</h2>
          <ul>
            {c.data.items.map((t) => <li>{t}</li>)}
          </ul>
        </article>
      ))
    }
  </div>
</section>

<style>
  .aud {
    background: #ffe7a3;
  }
  .two {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
  }
  .col {
    position: relative;
    padding: clamp(28px, 4vw, 48px);
    border: 4px solid var(--ink);
    border-radius: 36px;
    box-shadow: 0 10px 0 var(--ink);
    color: #fff;
    transition: transform 0.4s var(--ease-bounce);
  }
  .col.kids {
    background: var(--blue);
    rotate: -1deg;
  }
  .col.parents {
    background: var(--red);
    rotate: 1deg;
  }
  .col:hover {
    rotate: 0deg;
  }
  h2 {
    font-size: clamp(2.2rem, 1.6rem + 2.4vw, 3.4rem);
    margin-bottom: 1.2rem;
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 14px;
  }
  li {
    position: relative;
    padding-left: 2em;
    font-weight: 600;
    font-size: 1.1rem;
  }
  li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.35em;
    width: 1.1em;
    height: 1.1em;
    background: var(--sun);
    border: 3px solid var(--ink);
    border-radius: 50% 40% 55% 45%;
  }
  .col :global(.pic) {
    position: absolute;
    top: -34px;
    right: 22px;
    width: 96px;
    height: auto;
    animation: bob 3.4s ease-in-out infinite;
    filter: drop-shadow(0 6px 4px rgba(42, 33, 69, 0.3));
  }
  @keyframes bob {
    0%, 100% { transform: translateY(0) rotate(-5deg); }
    50% { transform: translateY(-10px) rotate(6deg); }
  }
  @media (max-width: 860px) {
    .two {
      grid-template-columns: 1fr;
      gap: 44px;
    }
  }
</style>
