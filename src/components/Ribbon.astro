---
interface Props {
  items: string[];
}
const { items } = Astro.props;
---

<div class="ribbon" aria-hidden="true">
  <div class="track">
    {
      [0, 1].map(() => (
        <ul>
          {items.map((t) => (
            <li>{t}</li>
          ))}
        </ul>
      ))
    }
  </div>
</div>

<style>
  .ribbon {
    position: relative;
    z-index: 3;
    margin-inline: -4%;
    transform: rotate(-1.6deg);
    background: var(--red-d);
    color: #fff;
    border-block: 4px solid var(--ink);
    overflow: hidden;
  }
  .track {
    display: flex;
    width: max-content;
    animation: scroll 38s linear infinite;
  }
  .track ul {
    display: flex;
    margin: 0;
    padding: 0.5em 0;
    list-style: none;
  }
  .track li {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 1rem + 1vw, 1.7rem);
    white-space: nowrap;
    padding-inline: 1.1em;
    display: flex;
    align-items: center;
    gap: 2.2em;
  }
  .track li::after {
    content: '';
    width: 0.5em;
    height: 0.5em;
    background: var(--sun);
    border-radius: 50%;
  }
  @keyframes scroll {
    to { transform: translateX(-50%); }
  }
</style>
