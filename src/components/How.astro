---
import DeviceFrame from './DeviceFrame.astro';
import type { Copy } from '../i18n/id';

interface Props {
  copy: Copy;
}
const { copy } = Astro.props;
const h = copy.how;
// One short screen recording per step, in the same order as the steps in the copy (public/clips).
const clips = ['pick', 'paint', 'gallery', 'report'];
---

<section class="how sheet" id="cara-main">
  <div class="wrap">
    <div class="head">
      <p class="kicker" data-reveal>{h.kicker}</p>
      <h2 class="h2" data-reveal style="--d:1">{h.title}</h2>
    </div>

    <div class="steps">
      {
        h.steps.map((step, i) => (
          <article class:list={['step', { flip: i % 2 === 1 }]} data-reveal>
            <div class="vis">
              <DeviceFrame clip={clips[i]} label={step.alt} />
            </div>
            <div class="txt">
              <span class="badge puffy">{i + 1}</span>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .how {
    --bg: #2f8bec;
    background: linear-gradient(180deg, #2f8bec, #1b55c0);
    color: #fff;
  }
  .how .kicker {
    background: rgba(255, 255, 255, 0.22);
    color: #fff;
    box-shadow: inset 0 2px 2px rgba(255, 255, 255, 0.4), 0 6px 10px -6px rgba(0, 0, 60, 0.5);
  }
  .head {
    margin-bottom: 4rem;
  }
  .steps {
    display: grid;
    gap: clamp(56px, 9vw, 120px);
  }
  .step {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: clamp(28px, 5vw, 72px);
    align-items: center;
  }
  .step.flip {
    grid-template-columns: 1fr 1.15fr;
  }
  .step.flip .vis {
    order: 2;
  }
  .badge {
    display: inline-grid;
    place-items: center;
    width: 56px;
    height: 56px;
    color: var(--ink);
    border-radius: 50%;
    font-family: var(--font-display);
    font-size: 2rem;
    margin-bottom: 1rem;
    --tint: #ffd54a;
  }
  h3 {
    font-size: clamp(2.2rem, 1.6rem + 2vw, 3.4rem);
    margin-bottom: 0.7rem;
  }
  .txt p {
    font-size: 1.15rem;
    max-width: 28em;
    opacity: 0.92;
  }
  .vis :global(.ipad) {
    transform: rotate(-2deg);
    transition: transform 0.5s var(--ease-bounce);
  }
  .step.flip .vis :global(.ipad) {
    transform: rotate(2deg);
  }
  .vis:hover :global(.ipad) {
    transform: rotate(0) scale(1.02);
  }

  @media (max-width: 860px) {
    .step,
    .step.flip {
      grid-template-columns: 1fr;
    }
    .step.flip .vis {
      order: 0;
    }
  }
</style>
