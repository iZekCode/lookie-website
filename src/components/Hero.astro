---
// The top of the landing page: the headline on one side, and on the other an iPad playing short highlights of the app with the four animals on its corners.
import { Image } from 'astro:assets';
import kepik from '../assets/critters/kepik.png';
import kupu from '../assets/critters/kupu.png';
import lebah from '../assets/critters/lebah.png';
import siput from '../assets/critters/siput.png';
import DeviceFrame from './DeviceFrame.astro';
import Wordmark from './Wordmark.astro';
import type { Copy } from '../i18n/id';

interface Props {
  copy: Copy;
}
const { copy } = Astro.props;
const h = copy.hero;
const pals = [kepik, kupu, lebah, siput];
---

<section class="hero" id="top">
  <div class="wrap hero-in">
    <div class="hero-copy">
      <Wordmark class="mark" />
      <h1>
        <span>{h.titleA}</span> <span class="hl">{h.titleB}</span>
      </h1>
      <p class="lead">{h.sub}</p>
      <div class="cta">
        <a class="btn" href="#mencoba">{h.primary}</a>
      </div>
    </div>

    <div class="stage">
      <DeviceFrame clip="highlights" label={h.videoAlt} class="screen" preload="auto" />
      <div class="pals" aria-hidden="true">
        {
          pals.map((src, i) => (
            <div class={`pal pal${i}`}>
              <Image src={src} alt="" width={640} height={640} widths={[240, 480]} sizes="(max-width: 700px) 22vw, 120px" loading="eager" />
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    align-items: center;
    padding: 110px 0 80px;
    overflow: clip;
  }
  .hero-in {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 56px;
    align-items: center;
  }
  .hero-copy {
    display: grid;
    justify-items: center;
    text-align: center;
  }
  .hero-copy :global(.mark) {
    width: min(100%, 460px, 52vh);
    margin: 0 0 1.6rem;
    filter: drop-shadow(0 8px 0 rgba(42, 33, 69, 0.14));
  }
  h1 {
    font-size: clamp(1.9rem, 1rem + 2.2vw, 3rem);
    line-height: 1.12;
    margin-bottom: 1.6rem;
  }
  .hl {
    color: #fff;
    padding: 0.02em 0.32em 0.1em;
    background: radial-gradient(80% 50% at 24% 4%, rgba(255, 255, 255, 0.55), rgba(255, 255, 255, 0) 60%), linear-gradient(180deg, #5aa4ff, #1f5fd6);
    border-radius: 0.45em;
    box-shadow: inset 0 -6px 10px rgba(0, 0, 60, 0.28), 0 14px 18px -10px rgba(31, 95, 214, 0.7);
    text-shadow: 0 2px 0 rgba(0, 0, 60, 0.22);
    transform: rotate(-1.5deg);
    display: inline-block;
  }
  .lead {
    margin-inline: auto;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
    margin: 1.6rem 0 0;
  }
  .stage {
    position: relative;
    width: min(100%, 640px);
    margin-inline: auto;
    padding: 4%;
  }
  .stage :global(.screen) {
    rotate: 1.5deg;
  }
  .pal {
    position: absolute;
    width: clamp(64px, 20%, 130px);
    aspect-ratio: 1;
  }
  .pal0 { left: -2%; top: -6%; }
  .pal1 { right: -2%; top: -8%; }
  .pal2 { left: -3%; bottom: -8%; }
  .pal3 { right: -2%; bottom: -9%; }
  .pal :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 10px 12px rgba(42, 33, 69, 0.22));
  }
  @media (min-width: 960px) {
    .hero-in {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
      gap: clamp(32px, 5vw, 72px);
    }
    .hero-copy {
      justify-items: start;
      text-align: left;
    }
    .lead {
      margin-inline: 0;
    }
    .cta {
      justify-content: flex-start;
    }
    .stage {
      width: 100%;
      margin-inline: 0;
    }
  }
</style>
