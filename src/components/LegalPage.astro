---
import Base from '../layouts/Base.astro';
import { localePath, useCopy, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  kind: 'privacy' | 'terms' | 'support';
}
const { lang, kind } = Astro.props;
const copy = useCopy(lang);

const docs = import.meta.glob('../content/legal/*.md', { eager: true }) as Record<string, { Content: any }>;
const { Content } = docs[`../content/legal/${kind}.${lang}.md`];

const titles = { privacy: copy.legal.privacyTitle, terms: copy.legal.termsTitle, support: copy.legal.supportTitle };
const descs = { privacy: copy.legal.privacyDesc, terms: copy.legal.termsDesc, support: copy.legal.supportDesc };
const others = (['privacy', 'terms', 'support'] as const).filter((k) => k !== kind);
const labels = { privacy: copy.footer.privacy, terms: copy.footer.terms, support: copy.footer.support };
---

<Base lang={lang} title={`${titles[kind]} | Lookie`} description={descs[kind]} twinPath={kind}>
  <main id="main" class="legal">
    <div class="wrap page">
      <a class="back" href={localePath(lang)}>← {copy.legal.back}</a>
      <article class="paper">
        <h1>{titles[kind]}</h1>
        <div class="prose">
          <Content />
        </div>
      </article>
      <nav class="more" aria-label={copy.legal.otherPages}>
        <span>{copy.legal.otherPages}:</span>
        {others.map((k) => <a href={localePath(lang, k)}>{labels[k]}</a>)}
      </nav>
    </div>
  </main>
</Base>

<style>
  .legal {
    padding-block: 24px 140px;
  }
  .page {
    max-width: 820px;
  }
  .back {
    display: inline-block;
    font-weight: 700;
    text-decoration: none;
    margin-bottom: 20px;
    padding: 0.4em 0.9em 0.4em 0.7em;
    border-radius: 99px;
    background: linear-gradient(180deg, #fffdf6, #fbeed2);
    box-shadow:
      inset 0 2px 2px #fff,
      0 8px 12px -8px rgba(42, 33, 69, 0.45);
    transition: transform 0.2s var(--ease-bounce);
  }
  .back:hover {
    transform: translateX(-4px);
  }
  .paper {
    background: var(--paper);
    border: 4px solid var(--ink);
    border-radius: 36px;
    box-shadow: 0 10px 0 var(--ink);
    padding: clamp(28px, 5vw, 56px);
  }
  h1 {
    font-size: clamp(2.4rem, 1.6rem + 3.2vw, 3.8rem);
    margin-bottom: 1.4rem;
    color: var(--blue-d);
  }
  .more {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 22px;
    margin-top: 36px;
    font-weight: 600;
  }
  .more span {
    color: var(--ink-soft);
  }
  .more a {
    text-underline-offset: 4px;
  }
  .prose :global(h2) {
    font-size: 2rem;
    margin: 2.2rem 0 0.7rem;
    color: var(--red-d);
  }
  .prose :global(p),
  .prose :global(li) {
    max-width: 66ch;
  }
  .prose :global(p) {
    margin: 0 0 1rem;
  }
  .prose :global(ul) {
    padding-left: 1.3rem;
    margin: 0 0 1rem;
  }
  .prose :global(li) {
    margin-bottom: 0.45rem;
  }
  .prose :global(li::marker) {
    color: var(--blue);
  }
  .prose :global(a) {
    color: var(--blue-d);
    font-weight: 600;
  }
  .prose :global(table) {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    margin: 1rem 0 1.4rem;
    font-size: 0.95rem;
    border: 3px solid var(--ink);
    border-radius: 18px;
    overflow: hidden;
  }
  .prose :global(th) {
    background: var(--sun);
    text-align: left;
  }
  .prose :global(th),
  .prose :global(td) {
    padding: 0.7em 0.9em;
    vertical-align: top;
    border-bottom: 1px solid rgba(42, 33, 69, 0.15);
  }
  .prose :global(tr:last-child td) {
    border-bottom: 0;
  }
  @media (max-width: 640px) {
    .prose :global(table) {
      display: block;
      overflow-x: auto;
    }
  }
</style>
