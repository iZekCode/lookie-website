---
import { Image } from 'astro:assets';
import kids1 from '../assets/testing/kids-1.webp';
import kids2 from '../assets/testing/kids-2.webp';
import experts1 from '../assets/testing/experts-1.jpg';
import experts2 from '../assets/testing/experts-2.png';
import type { Copy } from '../i18n/id';

interface Props {
  copy: Copy;
}
const { copy } = Astro.props;
const t = copy.testing;
const kidPhotos = [kids1, kids2];
const expertPhotos = [experts1, experts2];
// Where each crop is anchored, so the iPad stays in frame.
const kidFocus = ['88% 50%', '60% 50%'];
---

<section class="test sheet">
  <div class="wrap">
    <div class="card puffy" data-reveal>
      <p class="ribbon puffy">{t.kicker}</p>
      <h2 class="h2">{t.title}</h2>
      <p class="lead intro">{t.intro}</p>

      <div class="group">
        <div class="photos">
          {
            t.kids.alts.map((alt, i) => (
              <Image class="shot" style={`object-position:${kidFocus[i]}`} src={kidPhotos[i]} alt={alt} width={440} height={330} widths={[440, 880]} sizes="(max-width: 560px) 80vw, 420px" />
            ))
          }
        </div>
        <h3 class="gtitle">{t.kids.title}</h3>
        <p class="gtext">{t.kids.text}</p>
      </div>

      <div class="group">
        <div class="photos">
          {
            t.experts.alts.map((alt, i) => (
              <Image class="shot" src={expertPhotos[i]} alt={alt} width={440} height={330} widths={[440, 880]} sizes="(max-width: 560px) 80vw, 420px" />
            ))
          }
        </div>
        <h3 class="gtitle">{t.experts.title}</h3>
        <figure class="quote">
          <blockquote>{t.experts.quote}</blockquote>
          <figcaption>
            <span class="who">{t.experts.name}</span>
            <span class="role">{t.experts.role}</span>
          </figcaption>
        </figure>
      </div>
    </div>
  </div>
</section>

<style>
  .test {
    --bg: #fffbf1;
  }
  .card {
    --tint: #fff0d2;
    position: relative;
    max-width: 960px;
    margin-inline: auto;
    border-radius: 52px;
    padding: clamp(44px, 6vw, 76px) clamp(20px, 5vw, 64px) clamp(36px, 5vw, 60px);
    text-align: center;
  }
  .ribbon {
    --tint: #cf3a22;
    position: absolute;
    top: -24px;
    left: 50%;
    translate: -50% 0;
    rotate: -2deg;
    color: #fff;
    font-family: var(--font-display);
    font-size: 1.5rem;
    padding: 0.15em 1.3em 0.25em;
    border-radius: 99px;
    text-shadow: 0 2px 0 rgba(90, 0, 0, 0.3);
  }
  .h2 {
    margin-bottom: 1rem;
  }
  .intro {
    max-width: 620px;
    margin-inline: auto;
    color: var(--ink);
  }
  .group {
    margin-top: clamp(32px, 5vw, 52px);
  }
  .photos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(14px, 3vw, 28px);
  }
  .photos :global(.shot) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
    border: 6px solid #fff;
    border-radius: 28px;
    box-shadow: 0 22px 34px -22px rgba(42, 33, 69, 0.55);
    rotate: -1.5deg;
    transition: rotate 0.3s ease;
  }
  .photos :global(.shot:nth-child(2)) {
    rotate: 1.5deg;
  }
  .photos :global(.shot:hover) {
    rotate: 0deg;
  }
  .gtitle {
    margin: 1.6rem 0 0.4rem;
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 3vw, 1.8rem);
    color: var(--ink);
  }
  .gtext {
    max-width: 560px;
    margin-inline: auto;
    font-size: 1.1rem;
    line-height: 1.55;
    color: var(--ink);
  }
  .quote {
    position: relative;
    max-width: 680px;
    margin: 1.4rem auto 0;
    padding: 1.6rem 1.6rem 1.3rem;
    border-radius: 28px;
    background: #fff;
    box-shadow: 0 18px 30px -22px rgba(42, 33, 69, 0.45);
    text-align: left;
  }
  .quote::before {
    content: '“';
    position: absolute;
    top: -0.2em;
    left: 0.35em;
    font-family: var(--font-display);
    font-size: 4.5rem;
    line-height: 1;
    color: #cf3a22;
  }
  blockquote {
    margin: 0.7rem 0 0.9rem;
    font-size: 1.15rem;
    line-height: 1.6;
    color: var(--ink);
  }
  figcaption {
    display: grid;
    gap: 2px;
  }
  .who {
    font-weight: 700;
    color: var(--ink);
  }
  .role {
    font-size: 0.95rem;
    color: var(--ink-soft);
  }
  @media (max-width: 560px) {
    .photos {
      grid-template-columns: 1fr;
    }
    .card {
      border-radius: 40px;
    }
  }
</style>
