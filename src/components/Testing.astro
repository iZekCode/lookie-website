---
import type { Copy } from '../i18n/id';

interface Props {
  copy: Copy;
}
const { copy } = Astro.props;
const t = copy.testing;
---

<section class="test sheet">
  <div class="wrap">
    <div class="card puffy" data-reveal>
      <p class="ribbon puffy">{t.kicker}</p>
      <h2 class="h2">{t.title}</h2>
      <div class="cols">
        <p class="lead">{t.p1}</p>
        <p class="lead">{t.p2}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .test {
    --bg: #fffbf1;
  }
  .card {
    --tint: #fff0d2;
    position: relative;
    max-width: 920px;
    margin-inline: auto;
    border-radius: 52px;
    padding: clamp(44px, 6vw, 76px) clamp(24px, 5vw, 64px) clamp(32px, 5vw, 56px);
    text-align: center;
  }
  .ribbon {
    --tint: #cf3a22;
    position: absolute;
    top: -24px;
    left: 50%;
    translate: -50% 0;
    rotate: -2deg;
    color: #fff;
    font-family: var(--font-display);
    font-size: 1.5rem;
    padding: 0.15em 1.3em 0.25em;
    border-radius: 99px;
    text-shadow: 0 2px 0 rgba(90, 0, 0, 0.3);
  }
  .h2 {
    margin-bottom: 1.4rem;
  }
  .cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px;
    text-align: left;
  }
  .lead {
    color: var(--ink);
  }
  @media (max-width: 760px) {
    .cols {
      grid-template-columns: 1fr;
      gap: 14px;
    }
  }
</style>
