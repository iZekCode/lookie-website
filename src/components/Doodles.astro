---
// Soft bubbles drifting behind the page.
const bubbles = [
  [6, 8, 220], [78, 4, 160], [90, 34, 260], [14, 42, 190], [52, 58, 240],
  [84, 72, 170], [8, 78, 250], [40, 90, 150], [66, 38, 120], [30, 18, 110],
];
---

<div class="bubbles" aria-hidden="true">
  {
    bubbles.map(([x, y, size], i) => (
      <span class="bubble" style={`--x:${x}%;--y:${y}%;--s:${size}px;--n:${i}`} />
    ))
  }
</div>

<style>
  .bubbles {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
    background: linear-gradient(180deg, #fff8e8 0%, #ffeecf 100%);
  }
  .bubble {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: var(--s);
    height: var(--s);
    border-radius: 50%;
    background:
      radial-gradient(circle at 30% 26%, rgba(255, 255, 255, 0.9) 0 7%, rgba(255, 255, 255, 0) 24%),
      radial-gradient(circle at 50% 55%, rgba(255, 214, 140, 0.35), rgba(255, 190, 110, 0.18) 70%, rgba(255, 170, 90, 0.28));
    box-shadow: inset 0 -10px 24px rgba(255, 170, 80, 0.18);
    animation: drift 16s ease-in-out calc(var(--n) * -2.1s) infinite;
  }
  @keyframes drift {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(16px, -30px) scale(1.04); }
  }
</style>
