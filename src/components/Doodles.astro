---
// Faint animal shapes scattered behind the page, like the wallpaper in the app's marketing art.
import kepik from '../assets/critters/kepik.png';
import kupu from '../assets/critters/kupu.png';
import lebah from '../assets/critters/lebah.png';
import siput from '../assets/critters/siput.png';

const shapes = [kepik, kupu, lebah, siput];
const spots = [
  [4, 6, 90, -12], [22, 3, 70, 10], [41, 9, 84, -6], [63, 4, 76, 14], [84, 8, 92, -10],
  [10, 26, 78, 8], [33, 31, 68, -14], [56, 27, 88, 6], [78, 30, 72, -8], [94, 24, 80, 12],
  [6, 52, 86, -6], [27, 58, 74, 12], [49, 54, 90, -10], [71, 60, 70, 8], [91, 50, 84, -4],
  [14, 80, 82, 10], [38, 86, 72, -12], [60, 82, 88, 6], [82, 88, 76, -8],
];
---

<div class="doodles" aria-hidden="true">
  {
    spots.map(([x, y, size, rot], i) => (
      <span
        class="doodle"
        style={`--x:${x}%;--y:${y}%;--s:${size}px;--r:${rot}deg;--n:${i};--m:url(${shapes[i % 4].src})`}
      />
    ))
  }
</div>

<style>
  .doodles {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
    background: var(--cream);
  }
  .doodle {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: var(--s);
    height: var(--s);
    background: #ffe9bd;
    -webkit-mask: var(--m) center / contain no-repeat;
    mask: var(--m) center / contain no-repeat;
    transform: rotate(var(--r));
    animation: drift 14s ease-in-out calc(var(--n) * -1.3s) infinite;
  }
  @keyframes drift {
    0%, 100% { transform: translate(0, 0) rotate(var(--r)); }
    50% { transform: translate(14px, -22px) rotate(calc(var(--r) + 9deg)); }
  }
</style>
