---
import { Image } from 'astro:assets';
import icon from '../assets/icon.png';
import type { Copy } from '../i18n/id';
import QRCode from 'qrcode';
import { testflightUrl } from '../lib/links';

interface Props {
  copy: Copy;
}
const { copy } = Astro.props;
const c = copy.cta;
const qr = await QRCode.toString(testflightUrl, { type: 'svg', margin: 0, color: { dark: '#2a2145', light: '#0000' } });
---

<section class="cta sheet" id="mencoba">
  <div class="wrap inner">
    <div class="txt">
      <h2 class="h2" data-reveal>{c.title}</h2>
      <p class="lead" data-reveal style="--d:1">{c.text}</p>
      <div class="btns" data-reveal style="--d:2">
        <a class="btn btn--red" href={testflightUrl} rel="noopener">{c.testflight}</a>
        <span class="soon" aria-disabled="true">{c.appstore}</span>
      </div>
      <div class="scan" data-reveal style="--d:3">
        <div class="qr" role="img" aria-label={c.qrAlt} set:html={qr} />
        <p>{c.scan}</p>
      </div>
      <div class="btns more" data-reveal style="--d:3">
        <a class="btn btn--ghost" href="mailto:littlecrewproject@gmail.com">{c.email}</a>
        <a class="btn btn--ghost" href="https://www.instagram.com/playwithlookie/" rel="noopener" target="_blank">{c.instagram}</a>
      </div>
    </div>
    <Image src={icon} alt="" width={360} height={360} class="mascot" data-reveal style="--d:1" />
  </div>
</section>

<style>
  .cta {
    --bg: #ffc933;
    padding-bottom: 150px;
  }
  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
    flex-wrap: wrap;
  }
  .txt {
    max-width: 640px;
  }
  .h2 {
    font-size: clamp(2.6rem, 1.6rem + 4vw, 4.8rem);
    margin-bottom: 1rem;
  }
  .lead {
    color: var(--ink);
    margin-bottom: 1.8rem;
  }
  .btns {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }
  .soon {
    display: inline-flex;
    align-items: center;
    padding: 0.95em 1.6em;
    border-radius: 999px;
    border: 2px dashed rgba(42, 33, 69, 0.45);
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 1.25rem;
    cursor: default;
    user-select: none;
  }
  .scan {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 1.6rem;
    max-width: 380px;
  }
  .qr {
    flex: none;
    width: 104px;
    height: 104px;
    padding: 10px;
    border-radius: 22px;
    background: #fff;
    box-shadow: inset 0 -6px 10px rgba(0, 0, 60, 0.1), 0 14px 20px -12px rgba(120, 60, 0, 0.5);
  }
  .qr :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .scan p {
    font-weight: 600;
    color: var(--ink);
  }
  .more {
    margin-top: 1.6rem;
  }
  .cta :global(.mascot) {
    width: clamp(150px, 22vw, 260px);
    height: auto;
    border-radius: 36%;
    box-shadow:
      inset 0 -14px 24px -8px rgba(0, 0, 60, 0.3),
      inset 0 8px 12px -2px rgba(255, 255, 255, 0.6),
      0 40px 50px -26px rgba(120, 60, 0, 0.6);
    rotate: 6deg;
    animation: wave 3.6s ease-in-out infinite;
  }
  @keyframes wave {
    0%, 100% { transform: rotate(0); }
    50% { transform: rotate(-8deg) translateY(-8px); }
  }
</style>
