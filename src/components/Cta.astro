---
import type { Copy } from '../i18n/id';
import QRCode from 'qrcode';
import { testflightUrl } from '../lib/links';

interface Props {
  copy: Copy;
}
const { copy } = Astro.props;
const c = copy.cta;
const qr = await QRCode.toString(testflightUrl, { type: 'svg', margin: 0, color: { dark: '#2a2145', light: '#0000' } });
---

<section class="cta sheet" id="mencoba">
  <div class="wrap inner">
    <div class="txt">
      <h2 class="h2" data-reveal>{c.title}</h2>
      <p class="lead" data-reveal style="--d:1">{c.text}</p>
      <div class="btns" data-reveal style="--d:2">
        <a class="btn btn--red" href={testflightUrl} rel="noopener">{c.testflight}</a>
      </div>
    </div>
    <a class="qr" href={testflightUrl} rel="noopener" aria-label={c.qrAlt} data-reveal style="--d:1">
      <span set:html={qr} />
    </a>
  </div>
</section>

<style>
  .cta {
    --bg: #ffc933;
  }
  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
    flex-wrap: wrap;
  }
  .txt {
    flex: 1 1 320px;
    max-width: 640px;
  }
  .h2 {
    font-size: clamp(2.6rem, 1.6rem + 4vw, 4.8rem);
    margin-bottom: 1rem;
  }
  .lead {
    color: var(--ink);
    margin-bottom: 1.8rem;
  }
  .btns {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }
  .qr {
    display: block;
    flex: none;
    width: clamp(200px, 26vw, 320px);
    aspect-ratio: 1;
    padding: clamp(16px, 2.4vw, 28px);
    border-radius: 12%;
    background: #fff;
    box-shadow: inset 0 -10px 16px rgba(0, 0, 60, 0.1), 0 40px 50px -26px rgba(120, 60, 0, 0.6);
    rotate: 3deg;
    transition: rotate 0.3s ease;
  }
  .qr:hover {
    rotate: 0deg;
  }
  .qr span,
  .qr :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }
  @media (max-width: 760px) {
    .qr {
      margin-inline: auto;
    }
  }
</style>
