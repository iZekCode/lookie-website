---
import { Image } from 'astro:assets';
import rizki from '../assets/team/rizki.png';
import filbert from '../assets/team/filbert.png';
import grace from '../assets/team/grace.png';
import kezia from '../assets/team/kezia.png';
import adri from '../assets/team/adri.png';
import type { Copy } from '../i18n/id';

interface Props {
  copy: Copy;
}
const { copy } = Astro.props;
const t = copy.team;
// Same order as the members in the copy.
const photos = [rizki, filbert, grace, kezia, adri];
// LinkedIn profile of each member, in the same order. Leave one empty and its icon is not shown.
const linkedin = [
  'https://www.linkedin.com/in/rzkihdyh',
  'https://www.linkedin.com/in/filbertnaldowijaya',
  'https://www.linkedin.com/in/graceila',
  'https://www.linkedin.com/in/kezia-karen-amelia',
  'https://www.linkedin.com/in/adriputra/',
];
const tints = ['#ffd1c9', '#cfe6ff', '#fff0b3', '#d9f3c9', '#e6d9ff'];
---

<section class="team sheet" id="tim">
  <div class="wrap">
    <header class="head" data-reveal>
      <h2 class="h2">{t.title}</h2>
    </header>
    <ul class="grid">
      {
        t.members.map((m, i) => (
          <li class="person" data-reveal style={`--d:${i % 3}; --tint:${tints[i]}`}>
            <div class="pic">
              <Image class="photo puffy" src={photos[i]} alt={m.name} width={160} height={160} widths={[160, 320]} sizes="140px" />
              {linkedin[i] && (
                <a class="social" href={linkedin[i]} target="_blank" rel="noopener" aria-label={`${m.name}: ${t.linkedin}`} title={t.linkedin}>
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M6.94 8.5H3.56V20h3.38V8.5ZM5.25 3.2a1.96 1.96 0 1 0 0 3.92 1.96 1.96 0 0 0 0-3.92ZM20.44 20h-3.38v-5.6c0-1.34-.03-3.06-1.87-3.06-1.87 0-2.15 1.46-2.15 2.96V20H9.66V8.5h3.24v1.57h.05c.45-.85 1.55-1.75 3.19-1.75 3.41 0 4.04 2.25 4.04 5.17V20Z" />
                  </svg>
                </a>
              )}
            </div>
            <p class="name">{m.name}</p>
            <p class="role">{m.role}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .team {
    --bg: #e6f2ff;
    padding-bottom: 100px;
  }
  .head {
    text-align: center;
    margin-bottom: 2.4rem;
  }
  .h2 {
    margin-top: 0.4rem;
  }
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 38px 40px;
  }
  .person {
    width: 190px;
    text-align: center;
  }
  .pic {
    position: relative;
    width: 132px;
    height: 132px;
    margin: 0 auto 16px;
    transition: transform 0.35s cubic-bezier(0.3, 1.6, 0.5, 1);
  }
  .person:hover .pic {
    transform: translateY(-6px) rotate(-3deg) scale(1.04);
  }
  .person :global(.photo) {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    display: block;
  }
  .social {
    position: absolute;
    right: -2px;
    bottom: 2px;
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 3px solid var(--bg);
    color: #fff;
    background: radial-gradient(80% 50% at 30% 8%, rgba(255, 255, 255, 0.5), rgba(255, 255, 255, 0) 60%), linear-gradient(180deg, #4fa0ff, #1f5fd6);
    box-shadow: inset 0 -4px 7px rgba(0, 0, 60, 0.3), 0 8px 12px -6px rgba(31, 95, 214, 0.7);
    transition: transform 0.25s cubic-bezier(0.3, 1.6, 0.5, 1);
  }
  .social:hover {
    transform: scale(1.15);
  }
  .social svg {
    width: 18px;
    height: 18px;
    fill: currentColor;
  }
  .name {
    font-weight: 800;
    line-height: 1.25;
    text-wrap: balance;
  }
  .role {
    color: var(--ink-soft);
    font-size: 0.95rem;
    margin-top: 2px;
  }
  @media (max-width: 560px) {
    .person {
      width: 150px;
    }
    .pic {
      width: 110px;
      height: 110px;
    }
  }
</style>
